# Connection token from https://aeac.mylonics.com
AEAC_COMP_TOKEN=

# Websocket URL. The token is added on the query string and is not part of this value.
AEAC_COMP_URL=wss://aeac.mylonics.com/telemetry

# UAV id the server expects in each 1 Hz packet
AEAC_COMP_UAV_ID=valiant-1

# 0 = loopback (default). 1 = open the websocket when the clock is plausible.
AEAC_COMP_LIVE=0
